# -----------------------------------------------------------------------------
# Configuración del Entorno de Pruebas (.env.testing) - BovWeight CR
# -----------------------------------------------------------------------------

APP_NAME="BovWeight CR (Entorno de Pruebas)"
APP_ENV=testing
APP_KEY=base64:fPXrEBIZeZHid0Ush3y8wlBztOqheEaQxZgZGS4qR9k=
APP_DEBUG=true
APP_URL=http://localhost

# Configuración de Base de Datos para Pruebas (MySQL en CI / SQLite Local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bovweight_testing
DB_USERNAME=root
DB_PASSWORD=

# Controladores rápidos in-memory para optimizar velocidad de pruebas
BCRYPT_ROUNDS=4
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local

# Configuración adicional de Laravel
LOG_CHANNEL=null
LOG_LEVEL=emergency
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
